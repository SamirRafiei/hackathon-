# Copy this file to .env.local. The starter page runs without these values.
# Use the public/publishable key from your team's Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: used only by `npm run db:types -- --project-id ...`.
# Authenticate the Supabase CLI separately; never put privileged keys in NEXT_PUBLIC_*.
# SUPABASE_PROJECT_ID=
